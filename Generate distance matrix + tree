import pandas as pd
from skbio.stats.distance import DistanceMatrix
from skbio.stats.distance import permanova
from sklearn.metrics import pairwise_distances

# metadata
meta = pd.read_csv("FINAL/metadata/sample_metadata.tsv", sep="\t")

# genome matrix
df = pd.read_csv("FINAL/roary_rebuilt/gene_presence_absence.csv")
X = df.iloc[:, 14:].notna().astype(int).T

# distance matrix (Jaccard)
dist = pairwise_distances(X, metric="jaccard")
dm = DistanceMatrix(dist, ids=X.index)

meta = meta.set_index("sample").loc[X.index]

# PERMANOVA lineage
res_lineage = permanova(dm, meta, column="lineage", permutations=999)
print("LINEAGE:\n", res_lineage)

# PERMANOVA host
res_host = permanova(dm, meta, column="host", permutations=999)
print("HOST:\n", res_host)

