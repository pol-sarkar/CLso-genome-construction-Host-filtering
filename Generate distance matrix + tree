import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

df = pd.read_csv("FINAL/roary_rebuilt/gene_presence_absence.csv")

X = df.iloc[:, 14:].notna().astype(int).T

# cluster map (VERY publication standard)
sns.clustermap(
    X,
    figsize=(10,10),
    cmap="viridis",
    xticklabels=False,
    yticklabels=True
)

plt.savefig("FINAL/pangenome_heatmap.png", dpi=300)
plt.show()
