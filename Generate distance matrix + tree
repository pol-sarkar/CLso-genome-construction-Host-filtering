#Generate distance matrix + tree (dendogram)
nano dendrogram.py

import pandas as pd
import numpy as np
from scipy.cluster.hierarchy import linkage, dendrogram
import matplotlib.pyplot as plt

df = pd.read_csv("FINAL/roary_rebuilt/gene_presence_absence.csv")

X = df.iloc[:, 14:].notna().astype(int).T

# distance = Jaccard (good for pan-genome)
from sklearn.metrics import pairwise_distances
dist = pairwise_distances(X, metric="jaccard")

Z = linkage(dist, method="average")

plt.figure(figsize=(10,5))
dendrogram(Z, labels=X.index, leaf_rotation=90)
plt.title("Core Genome Dendrogram (Roary)")
plt.tight_layout()

plt.savefig("FINAL/dendrogram.png", dpi=300)
plt.show()
