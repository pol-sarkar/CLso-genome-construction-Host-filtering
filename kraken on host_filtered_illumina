#FOR SYMBIONT % TABLE:

echo -e "Sample\tLiberibacter\tCarsonella\tSodalis\tArsenophonus\tSerratia\tWolbachia\tRickettsia" > symbiont_percent_table.tsv

for f in *.report
do

sample=$(basename "$f" .report)

lib=$(grep -m1 -iP "\tG\t34019\t.*Liberibacter$" "$f" | awk '{print $1}')
car=$(grep -m1 -i "Carsonella ruddii" "$f" | awk '{print $1}')
sod=$(grep -m1 -iP "\tG\t84565\t.*Sodalis$" "$f" | awk '{print $1}')
ars=$(grep -m1 -iP "\tG\t637\t.*Arsenophonus$" "$f" | awk '{print $1}')
ser=$(grep -m1 -iP "\tG\t613\t.*Serratia$" "$f" | awk '{print $1}')
wol=$(grep -m1 -iP "\tG\t953\t.*Wolbachia$" "$f" | awk '{print $1}')
ric=$(grep -m1 -iP "\tG\t780\t.*Rickettsia$" "$f" | awk '{print $1}')

echo -e "${sample}\t${lib:-0}\t${car:-0}\t${sod:-0}\t${ars:-0}\t${ser:-0}\t${wol:-0}\t${ric:-0}"

done >> symbiont_percent_table.tsv

