echo -e "Sample\tPercent\tCladeReads\tDirectReads\tRank\tTaxID\tName" > Liberibacter_summary.tsv

for f in kraken2_illumina_hostfiltered/*.report; do

    sample=$(basename "$f" .report)

    grep -i "Liberibacter" "$f" | \
    awk -v s="$sample" '{
        name=""
        for(i=6;i<=NF;i++) name=name $i " "
        print s"\t"$1"\t"$2"\t"$3"\t"$4"\t"$5"\t"name
    }'

done >> Liberibacter_summary.tsv
