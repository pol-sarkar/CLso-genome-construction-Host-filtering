import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.lines as mlines

pca = pd.read_csv("FINAL/pangenome_PCA_coordinates.tsv", sep="\t")
meta = pd.read_csv("FINAL/metadata/sample_metadata.tsv", sep="\t")

df = pca.merge(meta, on="sample")

colors = {
    "CLsoG":"red",
    "CLsoSumb2":"blue",
    "Sumb2":"cyan",
    "CLsoA":"green",
    "Southwestern":"orange",
    "CLsoF":"purple"
}

markers = {
    "Psyllid":"o",
    "Plant":"s"
}

plt.figure(figsize=(9,7))

# scatter plot (clean, no labels)
for _, row in df.iterrows():
    plt.scatter(
        row["PC1"],
        row["PC2"],
        color=colors[row["lineage"]],
        marker=markers[row["host"]],
        s=90,
        alpha=0.85
    )

# lineage legend
lineage_handles = [
    mlines.Line2D([], [], color=colors[k], marker='o', linestyle='None',
                  markersize=8, label=k)
    for k in colors
]

# host legend
host_handles = [
    mlines.Line2D([], [], color='black', marker=markers[k], linestyle='None',
                  markersize=8, label=k)
    for k in markers
]

plt.legend(handles=lineage_handles + host_handles, loc="best")

plt.xlabel("PC1")
plt.ylabel("PC2")
plt.title("Liberibacter Pan-genome PCA (Lineage + Host)")
plt.tight_layout()

plt.savefig("FINAL/pangenome_PCA_FINAL.png", dpi=300)
plt.show()
