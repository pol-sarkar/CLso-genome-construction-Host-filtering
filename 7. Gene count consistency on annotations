import pandas as pd
import numpy as np

df = pd.read_csv("FINAL/roary_rebuilt/gene_presence_absence.csv")

# gene matrix
X = df.iloc[:, 14:].notna().astype(int).T

# PCA via SVD
X_centered = X - X.mean(axis=0)
U, S, Vt = np.linalg.svd(X_centered, full_matrices=False)
coords = U[:, :2] * S[:2]

pca_df = pd.DataFrame({
    "sample": X.index,
    "PC1": coords[:,0],
    "PC2": coords[:,1]
})

pca_df.to_csv("FINAL/pangenome_PCA_coordinates.tsv", sep="\t", index=False)

print("DONE: PCA coordinates written")
print(pca_df.head())
