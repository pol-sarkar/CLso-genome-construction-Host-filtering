Step 2: Extract the FASTA Nucleotide Sequences
python3 -c '
import pandas as pd

tblastn_file = "../effectors/effector_tblastn_hits.tsv"
fasta_file = "../effectors/all_consensus_genomes.fna"
out_fasta = "../effectors/extracted_effector_hits_10samples.fasta"

# Load genome sequences into memory
genomes = {}
curr_header = None
curr_seq = []

with open(fasta_file) as f:
    for line in f:
        line = line.strip()
        if line.startswith(">"):
            if curr_header:
                genomes[curr_header] = "".join(curr_seq)
            curr_header = line[1:].split()[0]
            curr_seq = []
        else:
            curr_seq.append(line)
    if curr_header:
        genomes[curr_header] = "".join(curr_seq)

# Load tblastn hits
cols = ["qseqid", "sseqid", "pident", "length", "mismatch", "qstart", "qend", "sstart", "send", "evalue", "bitscore", "sseq"]
hits = pd.read_csv(tblastn_file, sep="\t", names=cols)

# Restrict to top hit per qseqid and sample (A_S1 to J_S10)
target_samples = ["A_S1", "B_S2", "C_S3", "D_S4", "E_S5", "F_S6", "G_S7", "H_S8", "I_S9", "J_S10"]
hits["sample"] = hits["sseqid"].apply(lambda x: x.split("_NC_")[0] if "_NC_" in x else x.split("_")[0])
hits_10 = hits[hits["sample"].isin(target_samples)]

top_hits = hits_10.sort_values("bitscore", ascending=False).groupby(["qseqid", "sample"]).first().reset_index()

# Helper for reverse complement
comp = str.maketrans("ATCGatcgNn", "TAGCtagcNn")
def rev_comp(seq):
    return seq.translate(comp)[::-1]

extracted_count = 0

with open(out_fasta, "w") as out:
    for _, row in top_hits.iterrows():
        sseqid = row["sseqid"]
        qseqid = row["qseqid"]
        sample = row["sample"]
        sstart = int(row["sstart"])
        send = int(row["send"])
        pident = row["pident"]
        
        if sseqid in genomes:
            full_seq = genomes[sseqid]
            start_idx = min(sstart, send) - 1
            end_idx = max(sstart, send)
            
            nt_seq = full_seq[start_idx:end_idx]
            
            if sstart > send:
                nt_seq = rev_comp(nt_seq)
                strand = "-"
            else:
                strand = "+"
                
            header = f">{qseqid}|{sample}|{sseqid}:{min(sstart,send)}-{max(sstart,send)}({strand})|pident={pident}"
            out.write(f"{header}\n{nt_seq}\n")
            extracted_count += 1

print(f"Done! Extracted {extracted_count} nucleotide sequences to:")
print(f"  --> {out_fasta}")
'
