One command to calculate reads
for f in NGS_fastq/*_R1_001.fastq.gz
do
    sample=$(basename $f _R1_001.fastq.gz)
    reads=$(zcat $f | awk 'END{print NR/4}')
    gb=$(echo "$reads*300/1000000000" | bc -l)
    echo -e "$sample\t$reads\t$gb Gb"
done

OR

for f in *_R1_001.fastq.gz
do
    sample=$(basename $f _R1_001.fastq.gz)
    reads=$(zcat $f | awk 'END{print NR/4}')
    gb=$(echo "$reads*2*301/1000000000" | bc -l)
    printf "%s\t%s reads\t%.2f Gb\n" $sample $reads $gb
done
